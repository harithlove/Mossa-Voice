# --- ล็อกอิน Google (OAuth client ชนิด Web application) ---
AUTH_SECRET=            # สร้างด้วย: npx auth secret  หรือ openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Google Sheet (Service Account) ---
SHEET_ID=               # ส่วนกลางของ URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=     # วางทั้งก้อนใน "..." ได้เลย ให้คง \n ไว้ตามไฟล์ JSON

# --- ความเป็นส่วนตัว ---
USER_HASH_SALT=         # สตริงสุ่มยาว ๆ ใช้แฮชรหัสผู้ใช้ Google ก่อนบันทึกลงชีต (ห้ามเปลี่ยนภายหลัง)

# --- แนบรูป/เสียง (ไม่บังคับ) ---
BLOB_READ_WRITE_TOKEN=  # Vercel > Storage > Blob จะสร้างให้อัตโนมัติ
